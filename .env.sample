# Copy to `.env.development` (or `.env.production`) and fill in.
# Only VITE_* vars reach the client bundle — never put a real secret here.
# Everything the app reads is declared in `src/config/env.ts` (zod-parsed).

# development | production
VITE_APP_STAGE=
# Vite `base` — subpath the app is served from. `/` for a domain root.
VITE_APP_BASE_URL=/
# Secret used to derive the key that encrypts persisted client storage (IndexedDB)
# and the `?data=` route tokens. Changing it invalidates existing sessions and links.
VITE_APP_ENCRYPT_KEY=
# API origin; endpoint paths from `lib/endpoints.ts` are appended.
VITE_APP_API_URL=
# Dev-only proxy target — leave empty unless proxying through Vite.
VITE_APP_API_TARGET=''
VITE_APP_API_TOKEN=""
# Account type sent on account-check + login.
VITE_APP_USER_TYPE=
# `false` hits the real auth backend (login/refresh/logout); `true` uses the demo session.
VITE_USE_MOCK_API=true

# --- Firebase (Phone Auth + Cloud Messaging) ---
# Single-line JSON copied from the Firebase console web-app config.
VITE_FIREBASE_CONFIG=
VITE_FIREBASE_VAPID_KEY=

# --- Google Maps ---
VITE_GOOGLE_MAPS_KEY=

# --- Optional ---
# Leaflet tile template; defaults to OpenStreetMap when unset.
# VITE_MAP_TILE_URL=
